FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ninja-build g++ git python3 python3-pip \
    libgl1-mesa-dev libssl-dev \
    libglib2.0-0 \
    libfontconfig1-dev libfreetype6-dev libdbus-1-dev \
    libxcb-cursor0 libxkbcommon-x11-0 \
    libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
    libxcb-randr0 libxcb-render-util0 libxcb-shape0 \
    libxcb-xinerama0 libxcb-xfixes0 libxcb-sync1 libxcb-util1 \
    wget file patchelf \
    zip imagemagick \
    libbz2-dev liblzma-dev liblz4-dev libzstd-dev \
    libnss3 libnspr4 libxcomposite1 libxdamage1 libxrandr2 libxtst6 \
    libxshmfence1 libxfixes3 libxcursor1 libgbm1 libdrm2 \
    libpango-1.0-0 libcairo2 libasound2 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
    && rm -rf /var/lib/apt/lists/*

# cmake from pip: apt on Ubuntu 22.04 ships 3.22, project requires 3.24+
RUN pip3 install --no-cache-dir cmake aqtinstall
